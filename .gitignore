ttb.code-workspace
.cursorignore
.cursorrules

# Dependencies
node_modules/

# Build, test coverage, and log outputs
build/
dist/
coverage/
npm-debug.log*

# OS files
.DS_Store

# Environment files
.env
.env*.local
.env.development
.env.production
.env.test
!.env.example
!client/.env.development
!client/.env.production

# BMAD personal configuration and generated runtime artifacts
/_bmad/config.user.toml
/_bmad/custom/*.user.toml
/_bmad/render/

# Python bytecode caches
__pycache__/
*.py[cod]

# Claude Code agent worktrees
.claude/worktrees/

# Private owner source books, PDFs, and locally extracted companion text (never commit)
data/private-sources/
